    "lint": "prettier --check 'src/**/*.sol' 'test/**/*.sol' 'script/**/*.sol'",
    "deploy": "forge script script/Deploy.s.sol --rpc-url https://sepolia.base.org --broadcast --verify --etherscan-api-key 8RV5PAP2EDEFF6V7Q9PXX5UCQMHUWV5CBR --private-key e6381192d3577c110ddba7c71560c9e5b45965f777d6d3d52a0048028fe3a0f5"
  },
  "dependencies": {
    "forge-std": "https://github.com/foundry-rs/forge-std#705263c95892a906d7af65f0f73ce8a4a0c80b80",
